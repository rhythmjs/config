{
  "name": "@rhythmjs/config",
  "version": "0.0.1",
  "description": "NestJS-style configuration module for Rhythm: ConfigModule.forRoot with config factories, registerAs namespaces, and a schema-validated, dot-path-typed ConfigService.",
  "keywords": [
    "config",
    "config-module",
    "config-service",
    "env",
    "environment",
    "rhythm",
    "standard-schema",
    "validation"
  ],
  "homepage": "https://rhythm.js.org/config",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp check && vp test && vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@rhythmjs/rhythm": "^0.0.9",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": "^0.0.9"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.2"
}
