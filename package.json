{
  "name": "@rhythmjs/config",
  "version": "0.0.2",
  "description": "NestJS-style configuration module for Rhythm: ConfigModule.forRoot with config factories, registerAs namespaces, and a schema-validated, dot-path-typed ConfigService.",
  "keywords": [
    "config",
    "config-module",
    "config-service",
    "env",
    "environment",
    "rhythm",
    "standard-schema",
    "validation"
  ],
  "homepage": "https://rhythm.js.org/config",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/config.ts src/types.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@rhythmjs/rhythm": "^0.0.11",
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": "^0.0.11"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
